<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ standfirst or site.description }}" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ standfirst or site.description }}" />
    <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Karla:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the writing</a>

    <header class="masthead shell">
      <div class="masthead__top">
        <a class="brand" href="/">
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect x="0" y="4" width="32" height="8" fill="#0a0a0a" />
            <rect x="0" y="13" width="32" height="6" fill="#e10600" />
            <rect x="0" y="20" width="32" height="8" fill="#0a0a0a" />
          </svg>
          <span class="brand__name">{{ site.title }}</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {% for item in site.nav %}
          <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.text }}</a>
          {% endfor %}
        </nav>
      </div>
      <p class="tagline">{{ site.tagline }}</p>
      <div class="masthead__rule"></div>
    </header>

    <main id="main" class="shell">{{ content | safe }}</main>

    <footer class="shell">
      <div class="foot">
        <p>Written by {{ site.authors.cloudy.name }} and {{ site.authors.tilen.name }}. Nobody edits us but each other.</p>
        <p>Every piece is also in the <a href="/feed.xml">feed</a>, if you still keep a reader.</p>
      </div>
    </footer>
  </body>
</html>
